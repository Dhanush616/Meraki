# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co

# ⚠️ Service-role key bypasses row-level security — keep this server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI providers
GEMINI_API_KEY=your-gemini-api-key

# Secrets (generate strong random values, e.g. `openssl rand -hex 32`)
ENCRYPTION_MASTER_KEY=32-byte-hex-string
JWT_SECRET=32-byte-hex-string

# URLs
# Comma-separated list of allowed frontend origins (CORS + links in emails)
FRONTEND_URL=http://localhost:3000

# Misc
ENVIRONMENT=development
PROJECT_NAME=Paradosis
