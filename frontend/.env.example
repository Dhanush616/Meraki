# Supabase (anon/public values — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI backend base URL (no trailing slash)
# Local: http://localhost:8000 — set to your deployed backend URL in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# App metadata
NEXT_PUBLIC_APP_NAME=Paradosis
NEXT_PUBLIC_APP_ENV=development
